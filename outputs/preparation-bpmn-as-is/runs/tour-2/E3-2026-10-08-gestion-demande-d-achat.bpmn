<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.27.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Interne" name="Gestion demande d'achat" processRef="Process_Interne" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Interne" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Service_demandeur_1" name="Service demandeur">
        <bpmn:flowNodeRef>E_EV1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_T1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Service_achats_2" name="Service achats">
        <bpmn:flowNodeRef>E_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_F1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_G4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_SP1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_G5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Controle_de_gestion_3" name="Contrôle de gestion">
        <bpmn:flowNodeRef>E_T3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_A_preciser___voir_question_Q6_4" name="À préciser — voir question Q6">
        <bpmn:flowNodeRef>E_T4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Magasin_5" name="Magasin">
        <bpmn:flowNodeRef>E_T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_F2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="E_EV1" name="Besoin d'achat">
      <bpmn:outgoing>Flow_EV1_T1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="E_T1" name="Faire demande d'achat">
      <bpmn:incoming>Flow_EV1_T1</bpmn:incoming>
      <bpmn:outgoing>Flow_T1_T2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="E_T2" name="Vérifier cohérence demande">
      <bpmn:incoming>Flow_T1_T2</bpmn:incoming>
      <bpmn:outgoing>Flow_T2_G1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="E_G1" name="Montant supérieur au seuil ?">
      <bpmn:incoming>Flow_T2_G1</bpmn:incoming>
      <bpmn:outgoing>Flow_G1_T3</bpmn:outgoing>
      <bpmn:outgoing>Flow_G1_G2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="E_T3" name="Valider demande d'achat">
      <bpmn:incoming>Flow_G1_T3</bpmn:incoming>
      <bpmn:outgoing>Flow_T3_G2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="E_G2">
      <bpmn:incoming>Flow_G1_G2</bpmn:incoming>
      <bpmn:incoming>Flow_T3_G2</bpmn:incoming>
      <bpmn:outgoing>Flow_G2_G3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="E_G3" name="Demande acceptée ?">
      <bpmn:incoming>Flow_G2_G3</bpmn:incoming>
      <bpmn:outgoing>Flow_G3_G4</bpmn:outgoing>
      <bpmn:outgoing>Flow_G3_F1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E_F1" name="Demande refusée">
      <bpmn:incoming>Flow_G3_F1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="E_G4" name="Fournisseur référencé ?">
      <bpmn:incoming>Flow_G3_G4</bpmn:incoming>
      <bpmn:outgoing>Flow_G4_T4</bpmn:outgoing>
      <bpmn:outgoing>Flow_G4_SP1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="E_T4" name="Créer commande dans SAP">
      <bpmn:incoming>Flow_G4_T4</bpmn:incoming>
      <bpmn:outgoing>Flow_T4_G5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:subProcess id="E_SP1" name="Traitement fournisseur non référencé">
      <bpmn:incoming>Flow_G4_SP1</bpmn:incoming>
      <bpmn:outgoing>Flow_SP1_G5</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="E_G5">
      <bpmn:incoming>Flow_T4_G5</bpmn:incoming>
      <bpmn:incoming>Flow_SP1_G5</bpmn:incoming>
      <bpmn:outgoing>Flow_G5_T5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="E_T5" name="Réceptionner marchandise">
      <bpmn:incoming>Flow_G5_T5</bpmn:incoming>
      <bpmn:outgoing>Flow_T5_F2</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="E_F2" name="Marchandise réceptionnée">
      <bpmn:incoming>Flow_T5_F2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_EV1_T1" sourceRef="E_EV1" targetRef="E_T1" />
