    <bpmn:textAnnotation id="Annot_G1"><bpmn:text>À préciser — voir question Q3</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_G1" sourceRef="E_G1" targetRef="Annot_G1" />
    <bpmn:textAnnotation id="Annot_T3"><bpmn:text>Non confirmé — voir question Q12</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_T3" sourceRef="E_T3" targetRef="Annot_T3" />
    <bpmn:textAnnotation id="Annot_G2"><bpmn:text>Supposé — à confirmer</bpmn:text></bpmn:textAnnotation>
