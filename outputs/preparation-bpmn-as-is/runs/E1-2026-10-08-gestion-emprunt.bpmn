<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.27.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_P1" name="Adhérent" processRef="Process_P1" />
    <bpmn:participant id="Participant_Interne" name="Gestion emprunt" processRef="Process_Interne" />
    <bpmn:messageFlow id="MsgFlow_1_P1_EV1" name="Demande d'emprunt" sourceRef="Participant_P1" targetRef="E_EV1" />
    <bpmn:messageFlow id="MsgFlow_2_P1_SP1" name="Informations adhérent" sourceRef="Participant_P1" targetRef="E_SP1" />
    <bpmn:messageFlow id="MsgFlow_3_P1_SP1" name="Cotisation" sourceRef="Participant_P1" targetRef="E_SP1" />
    <bpmn:messageFlow id="MsgFlow_4_P1_EV4" name="Ouvrage" sourceRef="Participant_P1" targetRef="E_EV4" />
    <bpmn:messageFlow id="MsgFlow_5_P1_EV6" name="Ouvrage" sourceRef="Participant_P1" targetRef="E_EV6" />
    <bpmn:messageFlow id="MsgFlow_6_SP1_P1" name="Demande d'informations" sourceRef="E_SP1" targetRef="Participant_P1" />
    <bpmn:messageFlow id="MsgFlow_7_SP1_P1" name="Demande de cotisation" sourceRef="E_SP1" targetRef="Participant_P1" />
    <bpmn:messageFlow id="MsgFlow_8_EV2_P1" name="Notification refus" sourceRef="E_EV2" targetRef="Participant_P1" />
    <bpmn:messageFlow id="MsgFlow_9_EV3_P1" name="Ouvrage" sourceRef="E_EV3" targetRef="Participant_P1" />
    <bpmn:messageFlow id="MsgFlow_10_T3_P1" name="Relance" sourceRef="E_T3" targetRef="Participant_P1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P1" isExecutable="false" />
  <bpmn:process id="Process_Interne" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Bibliothecaire_1" name="Bibliothécaire">
        <bpmn:flowNodeRef>E_EV1</bpmn:flowNodeRef>
