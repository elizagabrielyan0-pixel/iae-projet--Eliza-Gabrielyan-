        <bpmn:flowNodeRef>E_G6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_T5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Service_litige_2" name="Service litige">
        <bpmn:flowNodeRef>E_SP3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_EV9</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Documentaliste_3" name="Documentaliste">
        <bpmn:flowNodeRef>E_T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_EV8</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="E_EV1" name="Demande d'emprunt">
      <bpmn:outgoing>Flow_EV1_T1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_EV1" />
    </bpmn:startEvent>
    <bpmn:userTask id="E_T1" name="Rechercher adhérent">
      <bpmn:incoming>Flow_EV1_T1</bpmn:incoming>
      <bpmn:outgoing>Flow_T1_G1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="E_G1" name="Adhérent inscrit ?">
      <bpmn:incoming>Flow_T1_G1</bpmn:incoming>
      <bpmn:outgoing>Flow_G1_G2</bpmn:outgoing>
      <bpmn:outgoing>Flow_G1_SP1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="E_SP1" name="Création d'un adhérent">
      <bpmn:incoming>Flow_G1_SP1</bpmn:incoming>
      <bpmn:outgoing>Flow_SP1_G2</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="E_G2">
      <bpmn:incoming>Flow_G1_G2</bpmn:incoming>
      <bpmn:incoming>Flow_SP1_G2</bpmn:incoming>
      <bpmn:outgoing>Flow_G2_SP2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="E_SP2" name="Validation d'un emprunt">
      <bpmn:incoming>Flow_G2_SP2</bpmn:incoming>
      <bpmn:outgoing>Flow_SP2_G3</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="E_G3" name="Emprunt possible ?">
      <bpmn:incoming>Flow_SP2_G3</bpmn:incoming>
      <bpmn:outgoing>Flow_G3_T2</bpmn:outgoing>
      <bpmn:outgoing>Flow_G3_EV2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E_EV2" name="Emprunt impossible">
      <bpmn:incoming>Flow_G3_EV2</bpmn:incoming>
      <bpmn:messageEventDefinition id="MED_EV2" />
    </bpmn:endEvent>
    <bpmn:userTask id="E_T2" name="Enregistrer emprunt">
      <bpmn:incoming>Flow_G3_T2</bpmn:incoming>
      <bpmn:outgoing>Flow_T2_EV3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateThrowEvent id="E_EV3" name="Ouvrage">
      <bpmn:incoming>Flow_T2_EV3</bpmn:incoming>
      <bpmn:outgoing>Flow_EV3_G4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_EV3" />
    </bpmn:intermediateThrowEvent>
    <bpmn:eventBasedGateway id="E_G4">
      <bpmn:incoming>Flow_EV3_G4</bpmn:incoming>
      <bpmn:outgoing>Flow_G4_EV4</bpmn:outgoing>
      <bpmn:outgoing>Flow_G4_EV5</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="E_EV4" name="Retour emprunt">
      <bpmn:incoming>Flow_G4_EV4</bpmn:incoming>
      <bpmn:outgoing>Flow_EV4_G6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_EV4" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="E_EV5" name="1 mois">
      <bpmn:incoming>Flow_G4_EV5</bpmn:incoming>
      <bpmn:outgoing>Flow_EV5_T3</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_EV5">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P1M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="E_T3" name="Relancer adhérent">
      <bpmn:incoming>Flow_EV5_T3</bpmn:incoming>
      <bpmn:outgoing>Flow_T3_G5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="E_G5">
      <bpmn:incoming>Flow_T3_G5</bpmn:incoming>
      <bpmn:outgoing>Flow_G5_EV6</bpmn:outgoing>
      <bpmn:outgoing>Flow_G5_EV7</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="E_EV6" name="Retour emprunt">
      <bpmn:incoming>Flow_G5_EV6</bpmn:incoming>
      <bpmn:outgoing>Flow_EV6_G6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_EV6" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="E_EV7" name="15 jours">
      <bpmn:incoming>Flow_G5_EV7</bpmn:incoming>
      <bpmn:outgoing>Flow_EV7_T4</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_EV7">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P15D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="E_T4" name="Transmettre dossier au service litige">
      <bpmn:incoming>Flow_EV7_T4</bpmn:incoming>
      <bpmn:outgoing>Flow_T4_SP3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:subProcess id="E_SP3" name="Gestion litige">
      <bpmn:incoming>Flow_T4_SP3</bpmn:incoming>
      <bpmn:outgoing>Flow_SP3_EV9</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:endEvent id="E_EV9" name="Emprunt clos en litige">
      <bpmn:incoming>Flow_SP3_EV9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="E_G6">
      <bpmn:incoming>Flow_EV4_G6</bpmn:incoming>
      <bpmn:incoming>Flow_EV6_G6</bpmn:incoming>
      <bpmn:outgoing>Flow_G6_T5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="E_T5" name="Enregistrer retour">
      <bpmn:incoming>Flow_G6_T5</bpmn:incoming>
      <bpmn:outgoing>Flow_T5_T6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="E_T6" name="Ranger ouvrage">
      <bpmn:incoming>Flow_T5_T6</bpmn:incoming>
      <bpmn:outgoing>Flow_T6_EV8</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="E_EV8" name="Emprunt terminé">
      <bpmn:incoming>Flow_T6_EV8</bpmn:incoming>
    </bpmn:endEvent>
