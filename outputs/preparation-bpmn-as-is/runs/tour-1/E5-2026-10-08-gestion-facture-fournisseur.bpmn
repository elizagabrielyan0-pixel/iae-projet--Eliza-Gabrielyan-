    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Accueil" name="Accueil">
        <bpmn:flowNodeRef>E_EV1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_T2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Comptable_fournisseurs" name="Comptable fournisseurs">
