  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_P1" name="Fournisseur" processRef="Process_P1" />
    <bpmn:participant id="Participant_P2" name="Responsable budget" processRef="Process_P2" />
    <bpmn:participant id="Participant_Interne" name="Gestion facture fournisseur" processRef="Process_Interne" />
    <bpmn:messageFlow id="MsgFlow_P1_EV1" name="Facture papier" sourceRef="Participant_P1" targetRef="E_EV1" />
    <bpmn:messageFlow id="MsgFlow_P1_EV2" name="Facture e-mail" sourceRef="Participant_P1" targetRef="E_EV2" />
    <bpmn:messageFlow id="MsgFlow_P1_SP1" name="Avoir" sourceRef="Participant_P1" targetRef="E_SP1" />
    <bpmn:messageFlow id="MsgFlow_P2_SP2" name="Validation" sourceRef="Participant_P2" targetRef="E_SP2" />
    <bpmn:messageFlow id="MsgFlow_SP1_P1" name="Demande de vérification" sourceRef="E_SP1" targetRef="Participant_P1" />
    <bpmn:messageFlow id="MsgFlow_SP2_P2" name="Facture à valider" sourceRef="E_SP2" targetRef="Participant_P2" />
    <bpmn:messageFlow id="MsgFlow_SP2_P2_7" name="Relance" sourceRef="E_SP2" targetRef="Participant_P2" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P1" isExecutable="false" />
  <bpmn:process id="Process_P2" isExecutable="false" />
