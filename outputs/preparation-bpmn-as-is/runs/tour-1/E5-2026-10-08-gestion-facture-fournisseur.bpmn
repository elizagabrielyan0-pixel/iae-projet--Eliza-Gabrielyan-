        <bpmn:flowNodeRef>E_G4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Tresorerie" name="Trésorerie">
        <bpmn:flowNodeRef>E_M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_T9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_T10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_G5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_T11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_G6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_F1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_DAF" name="DAF">
        <bpmn:flowNodeRef>E_T12</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="E_EV1" name="Facture papier">
      <bpmn:outgoing>Flow_EV1_T1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_EV1" />
    </bpmn:startEvent>
    <bpmn:manualTask id="E_T1" name="Scanner facture papier">
      <bpmn:incoming>Flow_EV1_T1</bpmn:incoming>
      <bpmn:outgoing>Flow_T1_T2</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="E_T2" name="Déposer facture dans boîte factures@">
      <bpmn:incoming>Flow_T1_T2</bpmn:incoming>
      <bpmn:outgoing>Flow_T2_G1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:startEvent id="E_EV2" name="Facture e-mail">
      <bpmn:outgoing>Flow_EV2_G1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_EV2" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="E_G1">
      <bpmn:incoming>Flow_T2_G1</bpmn:incoming>
      <bpmn:incoming>Flow_EV2_G1</bpmn:incoming>
      <bpmn:outgoing>Flow_G1_T3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="E_T3" name="Rechercher commande d'achat SAP">
      <bpmn:incoming>Flow_G1_T3</bpmn:incoming>
      <bpmn:outgoing>Flow_T3_G2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="E_G2" name="Commande d'achat associée ?">
      <bpmn:incoming>Flow_T3_G2</bpmn:incoming>
      <bpmn:outgoing>Flow_G2_T4</bpmn:outgoing>
      <bpmn:outgoing>Flow_G2_T8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="E_T4" name="Saisir facture avec commande (MIRO)">
      <bpmn:incoming>Flow_G2_T4</bpmn:incoming>
      <bpmn:outgoing>Flow_T4_T5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="E_T5" name="Contrôler écarts quantités et prix">
      <bpmn:incoming>Flow_T4_T5</bpmn:incoming>
      <bpmn:outgoing>Flow_T5_G3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="E_G3" name="Écart au-delà de la tolérance ?">
      <bpmn:incoming>Flow_T5_G3</bpmn:incoming>
      <bpmn:outgoing>Flow_G3_T6</bpmn:outgoing>
      <bpmn:outgoing>Flow_G3_G4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="E_T6" name="Bloquer facture au paiement">
      <bpmn:incoming>Flow_G3_T6</bpmn:incoming>
      <bpmn:outgoing>Flow_T6_SP1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:subProcess id="E_SP1" name="Gestion litige">
      <bpmn:incoming>Flow_T6_SP1</bpmn:incoming>
      <bpmn:outgoing>Flow_SP1_T7</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:userTask id="E_T7" name="Lever blocage facture">
      <bpmn:incoming>Flow_SP1_T7</bpmn:incoming>
      <bpmn:outgoing>Flow_T7_G4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="E_T8" name="Saisir facture sans commande (FB60)">
      <bpmn:incoming>Flow_G2_T8</bpmn:incoming>
      <bpmn:outgoing>Flow_T8_SP2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:subProcess id="E_SP2" name="Validation facture sans commande">
      <bpmn:incoming>Flow_T8_SP2</bpmn:incoming>
      <bpmn:outgoing>Flow_SP2_G4</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="E_G4">
      <bpmn:incoming>Flow_G3_G4</bpmn:incoming>
      <bpmn:incoming>Flow_T7_G4</bpmn:incoming>
      <bpmn:incoming>Flow_SP2_G4</bpmn:incoming>
      <bpmn:outgoing>Flow_G4_M1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="E_M1" name="Mardi et jeudi">
      <bpmn:incoming>Flow_G4_M1</bpmn:incoming>
      <bpmn:outgoing>Flow_M1_T9</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_M1" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="E_T9" name="Lancer proposition de paiement">
      <bpmn:incoming>Flow_M1_T9</bpmn:incoming>
      <bpmn:outgoing>Flow_T9_T10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="E_T10" name="Contrôler proposition de paiement">
      <bpmn:incoming>Flow_T9_T10</bpmn:incoming>
      <bpmn:outgoing>Flow_T10_G5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="E_G5" name="Montant au-dessus du seuil DAF ?">
      <bpmn:incoming>Flow_T10_G5</bpmn:incoming>
      <bpmn:outgoing>Flow_G5_T12</bpmn:outgoing>
      <bpmn:outgoing>Flow_G5_T11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="E_T11" name="Lancer paiement par virement">
      <bpmn:incoming>Flow_G5_T11</bpmn:incoming>
      <bpmn:outgoing>Flow_T11_G6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="E_T12" name="Signer virement">
      <bpmn:incoming>Flow_G5_T12</bpmn:incoming>
      <bpmn:outgoing>Flow_T12_G6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="E_G6">
      <bpmn:incoming>Flow_T11_G6</bpmn:incoming>
      <bpmn:incoming>Flow_T12_G6</bpmn:incoming>
      <bpmn:outgoing>Flow_G6_F1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E_F1" name="Facture payée">
      <bpmn:incoming>Flow_G6_F1</bpmn:incoming>
    </bpmn:endEvent>
