  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_P1" name="Fournisseur" processRef="Process_P1" />
    <bpmn:participant id="Participant_Interne" name="Gestion facture fournisseur" processRef="Process_Interne" />
    <bpmn:messageFlow id="MsgFlow_1_P1_EV1" name="Facture par e-mail" sourceRef="Participant_P1" targetRef="E_EV1" />
    <bpmn:messageFlow id="MsgFlow_2_P1_EV2" name="Facture par courrier" sourceRef="Participant_P1" targetRef="E_EV2" />
    <bpmn:messageFlow id="MsgFlow_3_P1_SP1" name="Avoir" sourceRef="Participant_P1" targetRef="E_SP1" />
    <bpmn:messageFlow id="MsgFlow_4_SP1_P1" name="Demande de vérification" sourceRef="E_SP1" targetRef="Participant_P1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P1" isExecutable="false" />
  <bpmn:process id="Process_Interne" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Comptable_fournisseurs_1" name="Comptable fournisseurs">
        <bpmn:flowNodeRef>E_EV1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_G2</bpmn:flowNodeRef>
