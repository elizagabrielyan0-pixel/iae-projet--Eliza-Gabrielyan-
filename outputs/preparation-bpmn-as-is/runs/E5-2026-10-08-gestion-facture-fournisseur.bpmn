        <bpmn:flowNodeRef>E_T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_G4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Accueil_2" name="Accueil">
        <bpmn:flowNodeRef>E_EV2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_T2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Acheteur_3" name="Acheteur">
        <bpmn:flowNodeRef>E_SP1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Responsable_budget_4" name="Responsable budget">
        <bpmn:flowNodeRef>E_SP2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Tresorerie_5" name="Trésorerie">
        <bpmn:flowNodeRef>E_EV3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_T8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_T9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_G5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_T11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_G6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_F1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_DAF_6" name="DAF">
        <bpmn:flowNodeRef>E_T10</bpmn:flowNodeRef>
      </bpmn:lane>
