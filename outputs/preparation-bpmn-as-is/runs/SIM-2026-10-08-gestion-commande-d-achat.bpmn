      <bpmn:incoming>Flow_T12_G7</bpmn:incoming>
      <bpmn:outgoing>Flow_G7_EV2</bpmn:outgoing>
      <bpmn:outgoing>Flow_G7_EV3</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="E_EV2" name="Accusé de réception de commande">
