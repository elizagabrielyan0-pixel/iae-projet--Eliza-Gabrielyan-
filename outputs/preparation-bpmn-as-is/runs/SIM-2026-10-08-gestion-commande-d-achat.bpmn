    <bpmn:exclusiveGateway id="E_G6">
      <bpmn:incoming>Flow_T7_G6</bpmn:incoming>
      <bpmn:incoming>Flow_T9_G6</bpmn:incoming>
      <bpmn:outgoing>Flow_G6_T10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="E_T10" name="Créer commande dans l'ERP">
      <bpmn:incoming>Flow_G6_T10</bpmn:incoming>
      <bpmn:outgoing>Flow_T10_T11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="E_T11" name="Envoyer commande au fournisseur">
      <bpmn:incoming>Flow_T10_T11</bpmn:incoming>
      <bpmn:outgoing>Flow_T11_G7</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="E_G7">
