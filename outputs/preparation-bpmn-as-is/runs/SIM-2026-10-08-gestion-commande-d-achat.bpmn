    <bpmn:startEvent id="E_EV1" name="Besoin d'achat">
      <bpmn:outgoing>Flow_EV1_T1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="E_T1" name="Saisir demande d'achat dans l'ERP">
      <bpmn:incoming>Flow_EV1_T1</bpmn:incoming>
      <bpmn:outgoing>Flow_T1_T2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="E_T2" name="Vérifier demande d'achat">
      <bpmn:incoming>Flow_T1_T2</bpmn:incoming>
      <bpmn:incoming>Flow_T4_T2</bpmn:incoming>
      <bpmn:outgoing>Flow_T2_G1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="E_G1" name="Demande complète ?">
      <bpmn:incoming>Flow_T2_G1</bpmn:incoming>
      <bpmn:outgoing>Flow_G1_G2</bpmn:outgoing>
      <bpmn:outgoing>Flow_G1_T3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="E_T3" name="Renvoyer demande au service avec commentaire">
      <bpmn:incoming>Flow_G1_T3</bpmn:incoming>
      <bpmn:outgoing>Flow_T3_T4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="E_T4" name="Corriger demande d'achat">
      <bpmn:incoming>Flow_T3_T4</bpmn:incoming>
      <bpmn:outgoing>Flow_T4_T2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="E_G2" name="Montant au-dessus du seuil ?">
      <bpmn:incoming>Flow_G1_G2</bpmn:incoming>
      <bpmn:outgoing>Flow_G2_T5</bpmn:outgoing>
      <bpmn:outgoing>Flow_G2_G4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="E_T5" name="Contrôler budget du service">
      <bpmn:incoming>Flow_G2_T5</bpmn:incoming>
      <bpmn:outgoing>Flow_T5_G3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="E_G3" name="Demande validée ?">
      <bpmn:incoming>Flow_T5_G3</bpmn:incoming>
      <bpmn:outgoing>Flow_G3_G4</bpmn:outgoing>
      <bpmn:outgoing>Flow_G3_T6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="E_T6" name="Notifier refus au service demandeur">
      <bpmn:incoming>Flow_G3_T6</bpmn:incoming>
      <bpmn:outgoing>Flow_T6_F1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E_F1" name="Demande refusée">
      <bpmn:incoming>Flow_T6_F1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="E_G4">
      <bpmn:incoming>Flow_G2_G4</bpmn:incoming>
      <bpmn:incoming>Flow_G3_G4</bpmn:incoming>
      <bpmn:outgoing>Flow_G4_G5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="E_G5" name="Fournisseur référencé ?">
      <bpmn:incoming>Flow_G4_G5</bpmn:incoming>
      <bpmn:outgoing>Flow_G5_T7</bpmn:outgoing>
      <bpmn:outgoing>Flow_G5_T8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="E_T7" name="Retenir fournisseur référencé et prix du contrat">
      <bpmn:incoming>Flow_G5_T7</bpmn:incoming>
      <bpmn:outgoing>Flow_T7_G6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="E_T8" name="Demander trois devis">
      <bpmn:incoming>Flow_G5_T8</bpmn:incoming>
      <bpmn:outgoing>Flow_T8_T9</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="E_T9" name="Choisir fournisseur">
