        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P3D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="E_T12" name="Relancer fournisseur par téléphone">
      <bpmn:incoming>Flow_EV3_T12</bpmn:incoming>
      <bpmn:outgoing>Flow_T12_G7</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="E_EV4" name="Livraison avec bon de livraison">
