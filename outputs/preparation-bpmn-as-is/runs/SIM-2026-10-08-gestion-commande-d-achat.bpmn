    <bpmn:messageFlow id="MsgFlow_1_P1_T9" name="Devis" sourceRef="Participant_P1" targetRef="E_T9" />
    <bpmn:messageFlow id="MsgFlow_2_P1_EV2" name="Accusé de réception de commande" sourceRef="Participant_P1" targetRef="E_EV2" />
    <bpmn:messageFlow id="MsgFlow_3_P1_EV4" name="Livraison avec bon de livraison" sourceRef="Participant_P1" targetRef="E_EV4" />
    <bpmn:messageFlow id="MsgFlow_4_T8_P1" name="Demande de devis" sourceRef="E_T8" targetRef="Participant_P1" />
    <bpmn:messageFlow id="MsgFlow_5_T11_P1" name="Commande" sourceRef="E_T11" targetRef="Participant_P1" />
    <bpmn:messageFlow id="MsgFlow_6_T12_P1" name="Relance" sourceRef="E_T12" targetRef="Participant_P1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P1" isExecutable="false" />
