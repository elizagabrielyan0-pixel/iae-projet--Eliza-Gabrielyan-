      <bpmn:outgoing>Flow_EV2_EV4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_EV2" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="E_EV3" name="3 jours">
      <bpmn:incoming>Flow_G7_EV3</bpmn:incoming>
      <bpmn:outgoing>Flow_EV3_T12</bpmn:outgoing>
